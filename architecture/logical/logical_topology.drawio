        <mxCell id="sb_change" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=10;spacingTop=8;spacingRight=10;size=16;" value="&lt;b&gt;CHANGE AUDIT: CHANGE-001&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Problem:&lt;/b&gt; DEV-PC-01 erroneously cabled to Floor 1 Switch.&lt;br&gt;• &lt;b&gt;Action:&lt;/b&gt; Relocated patch lead to &lt;code&gt;ACC-F2-01:Fa0/1&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Security:&lt;/b&gt; Cleared stale MAC on F1; Enabled Port-Security on F2.&lt;br&gt;• &lt;b&gt;Validation:&lt;/b&gt; 100% ICMP reachability to Core Gateway (10.10.10.1) &amp; Git Server (10.10.60.21)." vertex="1">
          <mxGeometry height="210" width="430" x="1260" y="40" as="geometry" />
        </mxCell>
        <mxCell id="sb_specs" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=10;spacingTop=8;spacingRight=10;size=16;" value="&lt;b&gt;INFRASTRUCTURE DESIGN SPECS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;L2 Bundling:&lt;/b&gt; LACP (802.3ad) Active-Active Po1..3&lt;br&gt;• &lt;b&gt;STP Protocol:&lt;/b&gt; Rapid-PVST+ (Sub-2s Failover)&lt;br&gt;• &lt;b&gt;L3 Forwarding:&lt;/b&gt; Centralized SVI on Core 1&lt;br&gt;• &lt;b&gt;Perimeter:&lt;/b&gt; Cisco ASA 5506-X Stateful NAT&lt;br&gt;• &lt;b&gt;Trunk Allowed:&lt;/b&gt; VLAN 10–90, Native VLAN 999" vertex="1">
          <mxGeometry height="190" width="430" x="1260" y="280" as="geometry" />
        </mxCell>
        <mxCell id="sb_ports" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=10;spacingTop=8;spacingRight=10;size=16;" value="&lt;b&gt;STANDARDIZED ACCESS PORT MAP&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Fa0/1 – Fa0/8:&lt;/b&gt; Primary Workstations (PortFast, BPDU Guard)&lt;br&gt;• &lt;b&gt;Fa0/9 – Fa0/18:&lt;/b&gt; Secondary Clients / Local Services&lt;br&gt;• &lt;b&gt;Fa0/19 – Fa0/20:&lt;/b&gt; Surveillance CCTV (VLAN 80)&lt;br&gt;• &lt;b&gt;Fa0/21 – Fa0/22:&lt;/b&gt; Access Points &amp; VoIP Phones&lt;br&gt;• &lt;b&gt;Fa0/23 – Fa0/24:&lt;/b&gt; LACP Uplinks to Core Layer" vertex="1">
          <mxGeometry height="190" width="430" x="1260" y="500" as="geometry" />
