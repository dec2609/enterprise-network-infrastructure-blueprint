        <mxCell id="note1" value="&lt;b&gt;Implementation Baseline v1.0-Final&lt;/b&gt;&lt;br&gt;Batch 1–8 evidence + 5 legacy configs remain untouched.&lt;br&gt;7 implementation configs are derived Packet Tracer artifacts." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
