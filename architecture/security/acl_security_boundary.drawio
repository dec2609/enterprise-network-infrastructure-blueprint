        <mxCell id="pep_guest" value="&lt;b&gt;SVI Vlan90 (Ingress PEP)&lt;/b&gt;&lt;br&gt;Policy: &lt;code&gt;ACL_GUEST_IN&lt;/code&gt;&lt;br&gt;• Permit: DNS / DHCP / Transit&lt;br&gt;• Deny: 10.10.0.0/16 (Corporate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
