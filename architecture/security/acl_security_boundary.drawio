        <mxCell id="sb_acl_summary" value="&lt;b&gt;ACL SECURITY MODEL SPECIFICATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Enforcement Point:&lt;/b&gt; Centralized Ingress on Core SVI Gateways.&lt;br&gt;• &lt;b&gt;Default Stance:&lt;/b&gt; Explicit Whitelist; Implicit Deny All.&lt;br&gt;• &lt;b&gt;Stateful Boundary:&lt;/b&gt; Perimeter ASA handles NAT &amp; Egress Inspection.&lt;br&gt;• &lt;b&gt;Lateral Defense:&lt;/b&gt; Workstation-to-Workstation traffic blocked.&lt;br&gt;• &lt;b&gt;Audit Trail:&lt;/b&gt; Matches logged via Core Syslog daemon." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=10;spacingTop=8;spacingRight=10;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
