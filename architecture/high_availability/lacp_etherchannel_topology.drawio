  <diagram id="ha-lacp-stp-topology" name="HA LACP and STP Topology">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zone_core" value="CORE / DISTRIBUTION REDUNDANCY LAYER" style="swimlane;html=1;rounded=1;fillColor=#fafafa;strokeColor=#b0b0b0;fontStyle=1;startSize=28;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="60" width="1140" height="290" />
        </mxCell>
        <mxCell id="zone_access" value="ACCESS SWITCH LAYER (DUAL LACP UPLINKS)" style="swimlane;html=1;rounded=1;fillColor=#fafafa;strokeColor=#b0b0b0;fontStyle=1;startSize=28;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="420" width="1140" height="310" />
        </mxCell>
        <mxCell id="core1" value="&lt;b&gt;CORE-L3-01&lt;/b&gt;&lt;br&gt;• Role: Active L3 Gateway &amp; Primary STP Root&lt;br&gt;• Rapid PVST+ Priority: 4096 (VLAN 10-90)&lt;br&gt;• Priority: 24576 (VLAN 999)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="130" width="360" height="140" />
        </mxCell>
        <mxCell id="core2" value="&lt;b&gt;CORE-L3-02&lt;/b&gt;&lt;br&gt;• Role: Standby L2 Core &amp; Secondary STP Root&lt;br&gt;• Rapid PVST+ Priority: 8192 (VLAN 10-90)&lt;br&gt;• Priority: 28672 (VLAN 999)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="130" width="360" height="140" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;ACC-F1-01 (Floor 1)&lt;/b&gt;&lt;br&gt;• STP Priority: 32768&lt;br&gt;• Po1 (Fa0/23-24)&lt;br&gt;• Active LACP Channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="490" width="280" height="110" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;ACC-F2-01 (Floor 2)&lt;/b&gt;&lt;br&gt;• STP Priority: 32768&lt;br&gt;• Po2 (Fa0/23-24)&lt;br&gt;• &lt;b&gt;[CHANGE-001 Anchor]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="490" width="280" height="110" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;ACC-F3-01 (Floor 3)&lt;/b&gt;&lt;br&gt;• STP Priority: 32768&lt;br&gt;• Po3 (Fa0/23-24)&lt;br&gt;• Active LACP Channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="880" y="490" width="280" height="110" />
        </mxCell>
        <mxCell id="e_core_link1" value="Primary Trunk: Gi1/0/23 (DESG FWD ↔ ROOT FWD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="core1" target="core2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_core_link2" value="Redundant Trunk: Gi1/0/24 (DESG FWD ↔ ALTN BLK)&lt;br&gt;[Sub-2s Convergence on Failover]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="core1" target="core2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_po1" value="Po1 (LACP Active)&lt;br&gt;Core Gi1/0/1-2 ↔ F1 Fa0/23-24&lt;br&gt;Allowed: 10-90, 999" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#6c8ebf;" edge="1" parent="1" source="core1" target="f1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_po2" value="Po2 (LACP Active)&lt;br&gt;Core Gi1/0/3-4 ↔ F2 Fa0/23-24&lt;br&gt;Allowed: 10-90, 999" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#6c8ebf;" edge="1" parent="1" source="core1" target="f2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e_po3" value="Po3 (LACP Active)&lt;br&gt;Core Gi1/0/5-6 ↔ F3 Fa0/23-24&lt;br&gt;Allowed: 10-90, 999" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#6c8ebf;" edge="1" parent="1" source="core1" target="f3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note_lacp" value="&lt;b&gt;LACP Aggregation Specs (802.3ad)&lt;/b&gt;&lt;br&gt;• Protocol: LACP (mode active on both ends)&lt;br&gt;• Bundling: 2x 100Mbps / 1Gbps member links&lt;br&gt;• Failover: Single link failure causes 0s packet drop&lt;br&gt;• Trunk Encapsulation: Dot1Q with Native VLAN 999" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="630" width="450" height="80" />
        </mxCell>
        <mxCell id="note_stp" value="&lt;b&gt;Rapid PVST+ Spanning-Tree Specs&lt;/b&gt;&lt;br&gt;• Mode: &lt;code&gt;spanning-tree mode rapid-pvst&lt;/code&gt;&lt;br&gt;• Edge Ports: &lt;code&gt;portfast&lt;/code&gt; &amp; &lt;code&gt;bpduguard enable&lt;/code&gt;&lt;br&gt;• Root Election: Deterministic via priority values&lt;br&gt;• Failover Recovery: Validated &lt;2.0s transition time" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="670" y="630" width="490" height="80" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
