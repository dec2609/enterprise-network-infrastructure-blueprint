  <diagram id="lacp-ha-topology" name="LACP &amp; STP HA Topology">
    <mxGraphModel dx="1650" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zone_core" value="CORE / DISTRIBUTION REDUNDANCY &amp; LACP CONTROL LAYER" style="swimlane;html=1;rounded=1;fillColor=#F8F9FA;strokeColor=#D0D5DD;fontStyle=1;startSize=28;fontSize=12;fontColor=#344054;swimlaneFillColor=#FFFFFF;collapsible=0;align=center;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="50" width="1140" height="300" />
        </mxCell>
        <mxCell id="zone_access" value="ACCESS LAYER (ACTIVE-ACTIVE LACP BUNDLES &amp; RAPID-PVST+ BOUNDARY)" style="swimlane;html=1;rounded=1;fillColor=#F8F9FA;strokeColor=#D0D5DD;fontStyle=1;startSize=28;fontSize=12;fontColor=#344054;swimlaneFillColor=#FFFFFF;collapsible=0;align=center;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="480" width="1140" height="320" />
        </mxCell>
        <mxCell id="core1" value="&lt;b&gt;CORE-L3-01 (Primary Gateway &amp; Root)&lt;/b&gt;&lt;br&gt;• Rapid-PVST+ Primary Root (Priority: 4096)&lt;br&gt;• Inter-Switch Trunk: Gi1/0/23-24 (Po10)&lt;br&gt;• SVI Gateway &amp; LACP Master: Po1, Po2, Po3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBFF;strokeColor=#9E77ED;fontStyle=1;fontSize=11;fontColor=#53389E;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="zone_core">
          <mxGeometry as="geometry" x="110" y="70" width="380" height="145" />
        </mxCell>
        <mxCell id="core2" value="&lt;b&gt;CORE-L3-02 (Secondary Standby Root)&lt;/b&gt;&lt;br&gt;• Rapid-PVST+ Secondary Root (Priority: 8192)&lt;br&gt;• Inter-Switch Trunk: Gi1/0/23-24 (Po10)&lt;br&gt;• L2 Standby Redundant Management Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBFF;strokeColor=#9E77ED;fontSize=11;fontColor=#53389E;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="zone_core">
          <mxGeometry as="geometry" x="650" y="70" width="380" height="145" />
        </mxCell>
        <mxCell id="acc_f1" value="&lt;b&gt;ACC-F1-01 (Floor 1 Access)&lt;/b&gt;&lt;br&gt;• Dual Uplink: Fa0/23-24 (Po1)&lt;br&gt;• Mode: LACP Active (IEEE 802.1AX)&lt;br&gt;• STP Role: Alternate / Root Port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FADF;strokeColor=#12B76A;fontStyle=1;fontSize=11;fontColor=#027A48;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="zone_access">
          <mxGeometry as="geometry" x="45" y="90" width="290" height="120" />
        </mxCell>
        <mxCell id="acc_f2" value="&lt;b&gt;ACC-F2-01 (Floor 2 Access)&lt;/b&gt;&lt;br&gt;• Dual Uplink: Fa0/23-24 (Po2)&lt;br&gt;• Mode: LACP Active (IEEE 802.1AX)&lt;br&gt;• &lt;b&gt;[CHANGE-001 Re-Anchored Node]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontStyle=1;fontSize=11;fontColor=#9A3412;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="zone_access">
          <mxGeometry as="geometry" x="435" y="90" width="290" height="120" />
        </mxCell>
        <mxCell id="acc_f3" value="&lt;b&gt;ACC-F3-01 (Floor 3 Access)&lt;/b&gt;&lt;br&gt;• Dual Uplink: Fa0/23-24 (Po3)&lt;br&gt;• Mode: LACP Active (IEEE 802.1AX)&lt;br&gt;• STP Role: Alternate / Root Port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FADF;strokeColor=#12B76A;fontStyle=1;fontSize=11;fontColor=#027A48;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="zone_access">
          <mxGeometry as="geometry" x="825" y="90" width="290" height="120" />
        </mxCell>
        <mxCell id="sb_lacp_spec" value="&lt;b&gt;LACP SPECIFICATION (IEEE 802.1AX)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Protocol Standard:&lt;/b&gt; IEEE 802.1AX (formerly 802.3ad).&lt;br&gt;• &lt;b&gt;Bundling Capacity:&lt;/b&gt; 2x 100Mbps FastEthernet per bundle (200Mbps aggregate).&lt;br&gt;• &lt;b&gt;Active Negotiation:&lt;/b&gt; Both ends configured in &lt;code&gt;channel-group X mode active&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Load Balancing:&lt;/b&gt; Source-Destination MAC address hashing (src-dst-mac).&lt;br&gt;• &lt;b&gt;Failover Continuity:&lt;/b&gt; Single-member failure; bundle remains operational without drop." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="50" width="370" height="260" />
        </mxCell>
        <mxCell id="sb_stp_spec" value="&lt;b&gt;RAPID-PVST+ REDUNDANCY MODEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Convergence Protocol:&lt;/b&gt; Rapid Per-VLAN Spanning Tree Plus.&lt;br&gt;• &lt;b&gt;Root Bridge Priority:&lt;/b&gt; Core 1 Primary (4096) / Core 2 Standby (8192).&lt;br&gt;• &lt;b&gt;Edge Protection:&lt;/b&gt; PortFast &amp; BPDU Guard enabled on host access ports.&lt;br&gt;• &lt;b&gt;Uplink Failover:&lt;/b&gt; Rapid PVST+ designed for rapid convergence on core uplink disruption.&lt;br&gt;• &lt;b&gt;Loop Prevention:&lt;/b&gt; Inter-core trunk Po10 maintains loop-free forwarding topology." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="340" width="370" height="260" />
        </mxCell>
        <mxCell id="sb_change_audit" value="&lt;b&gt;CHANGE-001 HA AUDIT SUMMARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Re-anchored Node:&lt;/b&gt; &lt;code&gt;ACC-F2-01&lt;/code&gt; uplink bundle verified on Po2.&lt;br&gt;• &lt;b&gt;Port-Security Status:&lt;/b&gt; Sticky MAC active on &lt;code&gt;ACC-F2-01:Fa0/1&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Cross-VLAN Routing:&lt;/b&gt; Verified via Core 1 Centralized SVIs (10.10.10.1).&lt;br&gt;• &lt;b&gt;Physical As-Built:&lt;/b&gt; Patch lead routed to Floor 2 Cat6 Field Termination." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="630" width="370" height="220" />
        </mxCell>
        <mxCell id="e_core_trunk" value="Po10 • 2x 1Gbps Redundant Trunk (Gi1/0/23-24)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;align=center;labelBackgroundColor=#FFFFFF;fontFamily=Arial, Helvetica, sans-serif;strokeColor=#7F56D9;strokeWidth=2.5;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="core1" target="core2">
