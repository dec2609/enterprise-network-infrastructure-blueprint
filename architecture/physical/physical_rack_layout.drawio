        <mxCell id="legend_box" value="&lt;b&gt;42U RACK SPECIFICATIONS &amp; THERMAL DESIGN&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Rack Dimension:&lt;/b&gt; 42U 19-inch Standard (600mm W x 1000mm D)&lt;br&gt;• &lt;b&gt;Cooling / Airflow:&lt;/b&gt; Front-to-Back Airflow with Blanking Panels&lt;br&gt;• &lt;b&gt;Power Distribution:&lt;/b&gt; Dual A/B Redundant Feed (2x 16A PDUs)&lt;br&gt;• &lt;b&gt;Battery Backup:&lt;/b&gt; 3000VA Online UPS with 15min Full-load Runtime&lt;br&gt;• &lt;b&gt;Cable Management:&lt;/b&gt; 1U Horizontal D-Ring Organizers between layers&lt;br&gt;&lt;br&gt;&lt;b&gt;COLOR LEGEND:&lt;/b&gt;&lt;br&gt;• &lt;font color='#6c8ebf'&gt;&lt;b&gt;Blue:&lt;/b&gt;&lt;/font&gt; WAN &amp; Perimeter Edge Routing (ISR 4331)&lt;br&gt;• &lt;font color='#b85450'&gt;&lt;b&gt;Red:&lt;/b&gt;&lt;/font&gt; Edge Security Firewall (ASA 5506-X)&lt;br&gt;• &lt;font color='#9673a6'&gt;&lt;b&gt;Purple:&lt;/b&gt;&lt;/font&gt; Core / Distribution Layer (Catalyst 3650)&lt;br&gt;• &lt;font color='#82b366'&gt;&lt;b&gt;Green:&lt;/b&gt;&lt;/font&gt; Access Layer Switches (Catalyst 2960)&lt;br&gt;• &lt;font color='#d6b656'&gt;&lt;b&gt;Yellow:&lt;/b&gt;&lt;/font&gt; High-Value Compute &amp; Server Farm&lt;br&gt;• &lt;font color='#666666'&gt;&lt;b&gt;Gray:&lt;/b&gt;&lt;/font&gt; Power Management &amp; Structured Patch Panels" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b0b0b0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="80" width="620" height="420" />
        </mxCell>
        <mxCell id="change_box" value="&lt;b&gt;PHYSICAL AS-BUILT RECONCILIATION (CHANGE-001)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Floor 2 Patch Panel:&lt;/b&gt; Port 01 physically connected to &lt;code&gt;ACC-F2-01:Fa0/1&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;DEV Workstation:&lt;/b&gt; Re-routed patch lead to Floor 2 Cat6 field termination.&lt;br&gt;• &lt;b&gt;Audit Status:&lt;/b&gt; Physical cabling matches As-Built Switch Port Plan." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b0b0b0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="530" width="620" height="140" />
        </mxCell>
