        <mxCell id="sb_rack_specs" value="&lt;b&gt;42U RACK SPECIFICATIONS &amp; THERMAL DESIGN&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Rack Dimension:&lt;/b&gt; 42U 19-inch Standard (600mm W x 1000mm D)&lt;br&gt;• &lt;b&gt;Cooling / Airflow:&lt;/b&gt; Front-to-Back Airflow with Blanking Panels Installed&lt;br&gt;• &lt;b&gt;Power Distribution:&lt;/b&gt; Dual A/B Redundant Feed (2x 16A Metered PDUs)&lt;br&gt;• &lt;b&gt;Battery Backup:&lt;/b&gt; 3000VA Online UPS with 15min Full-load Runtime&lt;br&gt;• &lt;b&gt;Cable Management:&lt;/b&gt; 1U Horizontal D-Ring Organizers between Active Layers" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="50" width="720" height="220" />
        </mxCell>
        <mxCell id="sb_color_legend" value="&lt;b&gt;RACK ELEVATION COLOR LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;font color='#0284C7'&gt;&lt;b&gt;Blue (WAN &amp; Edge):&lt;/b&gt;&lt;/font&gt; Cisco ISR 4331 Edge Router&lt;br&gt;• &lt;font color='#F04438'&gt;&lt;b&gt;Red (Security Boundary):&lt;/b&gt;&lt;/font&gt; Cisco ASA 5506-X Firewall&lt;br&gt;• &lt;font color='#9E77ED'&gt;&lt;b&gt;Purple (Core / Distribution):&lt;/b&gt;&lt;/font&gt; Catalyst 3650-24TD-E Switch Pair&lt;br&gt;• &lt;font color='#12B76A'&gt;&lt;b&gt;Green (Access Layer):&lt;/b&gt;&lt;/font&gt; Catalyst 2960-24TT Floor Switches&lt;br&gt;• &lt;font color='#D97706'&gt;&lt;b&gt;Amber (CHANGE-001 Anchor):&lt;/b&gt;&lt;/font&gt; ACC-F2-01 Floor 2 Re-anchored Switch&lt;br&gt;• &lt;font color='#CA8A04'&gt;&lt;b&gt;Yellow (Compute Farm):&lt;/b&gt;&lt;/font&gt; High-Value Compute &amp; Database Servers&lt;br&gt;• &lt;font color='#64748B'&gt;&lt;b&gt;Gray (Cabling &amp; Power):&lt;/b&gt;&lt;/font&gt; Structured Patch Panels, PDUs &amp; UPS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="300" width="720" height="250" />
        </mxCell>
        <mxCell id="sb_change_audit" value="&lt;b&gt;PHYSICAL AS-BUILT RECONCILIATION (CHANGE-001)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Patch Relocation:&lt;/b&gt; DEV-PC-01 patch lead re-routed to &lt;code&gt;Cat6 Patch Panel Floor 2 (Port 01)&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Switch Attachment:&lt;/b&gt; Directly cross-connected to &lt;code&gt;ACC-F2-01:Fa0/1&lt;/code&gt; at U25.&lt;br&gt;• &lt;b&gt;Physical Verification:&lt;/b&gt; Cable labeling tags verified against As-Built Port Schedule.&lt;br&gt;• &lt;b&gt;Audit Status:&lt;/b&gt; Physical installation matches 100% with Logical Architecture v1.0." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="580" width="720" height="210" />
        </mxCell>
        <mxCell id="sb_unit_summary" value="&lt;b&gt;RACK UNIT ALLOCATION BREAKDOWN&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;U36 – U42 (7U):&lt;/b&gt; WAN Gateway, Perimeter Firewall, PDU A &amp; Fiber Ingress&lt;br&gt;• &lt;b&gt;U31 – U35 (5U):&lt;/b&gt; Catalyst 3650 Core Switches &amp; Thermal Blanking&lt;br&gt;• &lt;b&gt;U22 – U30 (9U):&lt;/b&gt; Floor 1–3 Access Switches &amp; Interconnect Patch Panels&lt;br&gt;• &lt;b&gt;U11 – U21 (11U):&lt;/b&gt; High-Value Server Farm (Git, DB, DNS/DHCP) &amp; Airflow&lt;br&gt;• &lt;b&gt;U01 – U10 (10U):&lt;/b&gt; Expansion Capacity, Secondary PDU B &amp; 5U UPS System" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#FEDF89;fontSize=11;fontColor=#475467;align=left;spacingLeft=12;spacingTop=8;spacingRight=12;size=16;fontFamily=Arial, Helvetica, sans-serif;" vertex="1" parent="1">
